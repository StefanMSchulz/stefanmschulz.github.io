dup 37 /percent put
dup 43 /plus put
dup 114 /r put
dup 55 /seven put
dup 54 /six put
dup 51 /three put
dup 126 /tilde put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
